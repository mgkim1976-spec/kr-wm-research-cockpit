# 복사: cp .env.example .env  후 값을 채우세요. (.env 는 커밋되지 않습니다)

# KRX 수급 데이터 (data.krx.co.kr) — pykrx 로그인용. data.krx.co.kr 회원가입 후 발급.
KRX_ID=your_krx_id
KRX_PW=your_krx_password

# OpenAI — 종목 Talking Points(기회/리스크/GAP) 생성용. https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# (선택) 도시에 생성 모델. 기본 gpt-4o-mini
# DOSSIER_MODEL=gpt-4o-mini
